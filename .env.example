# ── közös ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/artistlist
# MapTiler kulcs — üresen hagyva OpenFreeMap (ingyenes, kulcs nélküli) tile-okat használunk
NEXT_PUBLIC_MAPTILER_KEY=

# Cloudinary (opcionális — nélküle URL-alapú képmegadás működik)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── apps/admin ─────────────────────────────────────────
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend — üresen hagyva a levelek a szerverkonzolra íródnak, email auto-verify
RESEND_API_KEY=
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ── apps/web ───────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
